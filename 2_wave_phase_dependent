        da4 = -dzeta * g * (aa + da3) * (bb + db)**2

        A[i+1,j+1] = aa + (da1 + 2*da2 + 2*da3 + da4)/6
    #SECOND ITERATION: CORRECTION W/FULL RK4 IMPLEMENTATION
    da = A[i+1,:] - A[i,:] 

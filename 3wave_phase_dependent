import numpy as np
import matplotlib.pyplot as plt

dtau = 0.02
dzeta = 0.025
tau = np.arange(0, 20, dtau)
zeta = np.arange(-35, 10, dzeta)
Ntau = len(tau)
Nzeta = len(zeta)

aR = np.empty((Ntau, Nzeta))
aI = np.empty((Ntau, Nzeta))
bR = np.empty((Ntau, Nzeta))
bI = np.empty((Ntau, Nzeta))
fR = np.empty((Ntau, Nzeta))
fI = np.empty((Ntau, Nzeta))

phi_a = np.empty((Ntau, Nzeta))
phi_b = np.empty((Ntau, Nzeta))
phi_f = np.empty((Ntau, Nzeta))
###PARAMS########################
g = 0.48
biggamma = 11.04
sigma = 1

a0 = 1
b0 = np.exp(-np.abs(zeta/sigma)**2)
f0 = 0
phi_a_initial = np.pi/3 * 0
phi_b_initial = np.pi/3 * 0
phi_f_initial = np.pi/3 * 0

aR[:,0] = a0 * np.cos(phi_a_initial)
aI[:,0] = a0 * np.sin(phi_a_initial)
aR[0,:] = a0 * np.cos(phi_a_initial)
aI[0,:] = a0 * np.sin(phi_a_initial)

bR[0,:] = b0 * np.cos(phi_b_initial)
bI[0,:] = b0 * np.sin(phi_b_initial)

fR[:,0] = 0   # far-left column: no incoming acoustic (keep)
fI[:,0] = 0
fR[0,:] = g*(aR[0,:]*bR[0,:] + aI[0,:]*bI[0,:])  
fI[0,:] = g*(aI[0,:]*bR[0,:] - aR[0,:]*bI[0,:])


for i in range(Ntau - 1):
    dbR1 = dtau * (aR[i,:]*fR[i,:] + aI[i,:]*fI[i,:])
    dbI1 = dtau * (-aR[i,:]*fI[i,:] + aI[i,:]*fR[i,:])
    bR[i+1,:] = bR[i,:] + dbR1
    bI[i+1,:] = bI[i,:] + dbI1
    fR[i+1,0] = g*(aR[i+1,0]*bR[i+1,0] + aI[i+1,0]*bI[i+1,0]) #note. 
    fI[i+1,0] = g*(aI[i+1,0]*bR[i+1,0] - aR[i+1,0]*bI[i+1,0])

    for j in range(Nzeta -1):
        bbR = bR[i+1,j]
        dbR = bR[i+1,j+1] - bR[i+1,j]
        bbI = bI[i+1,j]
        dbI = bI[i+1,j+1] - bI[i+1,j]

        aaR = aR[i+1,j]
        aaI = aI[i+1,j]
        ffR = fR[i+1,j]
        ffI = fI[i+1,j]

        if 2*biggamma > 1:
            #EUler + Backwards Euler for f
            aR[i+1,j+1] = aaR + dzeta * (bbI * ffI - bbR * ffR)
            aI[i+1,j+1] = aaI + dzeta * (- bbR * ffI - bbI * ffR)

            fR[i+1,j+1] = (g * aaR * bbR + g * aaI * bbI + ffR/(2*biggamma*dzeta))/(1 + 1/(2*biggamma*dzeta))
            fI[i+1,j+1] = (g * aaI * bbR - g * aaR * bbI + ffI/(2*biggamma*dzeta))/(1 + 1/(2*biggamma*dzeta))
            
        else: #RK4
            daR1 = dzeta * (bbI * ffI - bbR * ffR)
            daI1 = dzeta * (- bbR * ffI - bbI * ffR)
            dfR1 = dzeta * 2*biggamma*(g * aaR * bbR + g * aaI * bbI - ffR)
            dfI1 = dzeta * 2*biggamma*(g * aaI * bbR - g * aaR * bbI - ffI)
    
            daR2 = dzeta * ((bbI + dbI/2) * (ffI + dfI1/2) - (bbR + dbR/2) * (ffR + dfR1/2))
            daI2 = dzeta * (-(bbR + dbR/2) * (ffI + dfI1/2) - (bbI + dbI/2) * (ffR + dfR1/2))
            dfR2 = dzeta * 2*biggamma*(g * (aaR + daR1/2) * (bbR + dbR/2) + g * (aaI + daI1/2) * (bbI + dbI/2) - (ffR + dfR1/2))
            dfI2 = dzeta * 2*biggamma*(g * (aaI + daI1/2) * (bbR + dbR/2) - g * (aaR + daR1/2) * (bbI + dbI/2) - (ffI + dfI1/2))
    
            daR3 = dzeta * ((bbI + dbI/2) * (ffI + dfI2/2) - (bbR + dbR/2) * (ffR + dfR2/2))
            daI3 = dzeta * (-(bbR + dbR/2) * (ffI + dfI2/2) - (bbI + dbI/2) * (ffR + dfR2/2))
            dfR3 = dzeta * 2*biggamma*(g * (aaR + daR2/2) * (bbR + dbR/2) + g * (aaI + daI2/2) * (bbI + dbI/2) - (ffR + dfR2/2))
            dfI3 = dzeta * 2*biggamma*(g * (aaI + daI2/2) * (bbR + dbR/2) - g * (aaR + daR2/2) * (bbI + dbI/2) - (ffI + dfI2/2))
    
            daR4 = dzeta * ((bbI + dbI) * (ffI + dfI3) - (bbR + dbR) * (ffR + dfR3))
            daI4 = dzeta * (-(bbR + dbR) * (ffI + dfI3) - (bbI + dbI) * (ffR + dfR3))
            dfR4 = dzeta * 2*biggamma*(g * (aaR + daR3) * (bbR + dbR) + g * (aaI + daI3) * (bbI + dbI) - (ffR + dfR3))
            dfI4 = dzeta * 2*biggamma*(g * (aaI + daI3) * (bbR + dbR) - g * (aaR + daR3) * (bbI + dbI) - (ffI + dfI3))
    
            aR[i+1,j+1] = aaR + (daR1 + 2*daR2 + 2*daR3 + daR4)/6
            aI[i+1,j+1] = aaI + (daI1 + 2*daI2 + 2*daI3 + daI4)/6
            fR[i+1,j+1] = ffR + (dfR1 + 2*dfR2 + 2*dfR3 + dfR4)/6
            fI[i+1,j+1] = ffI + (dfI1 + 2*dfI2 + 2*dfI3 + dfI4)/6

        #Corrective Simpson's for seed

    aaR = aR[i,:]
    daR = aR[i+1,:] - aaR
    aaI = aI[i,:]
    daI = aI[i+1,:] - aaI
    ffR = fR[i,:]
    dfR = fR[i+1,:] - ffR
    ffI = fI[i,:]
    dfI = fI[i+1,:] - ffI

    dbR1 = dtau * (aaR * ffR + aaI * ffI)
    dbI1 = dtau * (-aaR * ffI + aaI * ffR)

    dbR2 = dtau * ((aaR + daR/2) * (ffR + dfR/2) + (aaI + daI/2) * (ffI + dfI/2))
    dbI2 = dtau * (-(aaR + daR/2) * (ffI + dfI/2) + (aaI + daI/2) * (ffR + dfR/2))

    dbR3 = dtau * ((aaR + daR) * (ffR + dfR) + (aaI + daI) * (ffI + dfI))
    dbI3 = dtau * (-(aaR + daR) * (ffI + dfI) + (aaI + daI) * (ffR + dfR))

    bR[i+1,:] = bR[i,:] + (dbR1 + 4*dbR2 + dbR3)/6
    bI[i+1,:] = bI[i,:] + (dbI1 + 4*dbI2 + dbI3)/6

    fR[i+1,0] = g*(aR[i+1,0]*bR[i+1,0] + aI[i+1,0]*bI[i+1,0])
    fI[i+1,0] = g*(aI[i+1,0]*bR[i+1,0] - aR[i+1,0]*bI[i+1,0])

#these are the magnitudes (what we are plotting)
a = np.sqrt(aR**2 + aI**2) 
b = np.sqrt(bR**2 + bI**2)
f = np.sqrt(fR**2 + fI**2)

phi_a = np.arctan2(aI, aR)
phi_b = np.arctan2(bI, bR)
phi_f = np.arctan2(fI, fR)

    ka3 = -dzeta * g * (aa + ka2/2) * (bb + db/2)**2
    ka4 = -dzeta * g * (aa + ka3) * (bb + db)**2
    A[0,j+1] = aa + (ka1 + 2*ka2 + 2*ka3 + ka4)/6

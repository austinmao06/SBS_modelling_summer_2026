from matplotlib.ticker import MultipleLocator, FuncFormatter

def format_pi_ticks(val, pos):
    """Format tick value as a fraction of pi."""
    frac = val / np.pi
    if np.isclose(frac, 0):
        return "0"
    # Express as a simple fraction using a small denominator search
    from fractions import Fraction
    f = Fraction(frac).limit_denominator(12)
    num, den = f.numerator, f.denominator
    sign = "-" if num < 0 else ""
    num = abs(num)
    if num == 0:
        return "0"
    if den == 1:
        return f"{sign}{num}π" if num != 1 else f"{sign}π"
    numstr = f"{num}" if num != 1 else ""
    return f"{sign}{numstr}π/{den}"

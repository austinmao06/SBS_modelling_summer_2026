import numpy as np
import matplotlib.pyplot as plt

###PARAMS########################
a0 = 1
f0 = 1
g = 1
G = 10000
sigma = 1
dtau = 0.02
dzeta = 0.025
tau = np.arange(0, 20, dtau)
zeta = np.arange(-25, 10, dzeta)
Ntau = len(tau)
Nzeta = len(zeta)

a = np.empty((Ntau, Nzeta))
b = np.empty((Ntau, Nzeta))
f = np.empty((Ntau, Nzeta))

##Deploy ICs#############################################################
b[0,:] = 0                                    # initial seed profile
a[:,0] = a0                                   # constant pump source (boundary)
a[0,:] = a0                                   # initial pump (placeholder, undepleted)
f[:,0] = 0                                    # far-left limit of no acoustic
f[0,:] = f0 * np.exp(-np.abs(zeta/sigma)**2) + f0 * np.exp(-np.abs((zeta-5)/sigma)**2)  # initial acoustic profile


###Integration############################################################

b[1,:] = b[0,:] + dtau * g * a[0,:] * f[0,:]

for i in range(Ntau - 1):
    for j in range(Nzeta - 1):
        bb = b[i+1,j]
        db = b[i+1,j+1] - bb

        aa = a[i+1,j]
        ff = f[i+1,j]
        
        if 2*G > 1:
            a[i+1, j+1] = aa - dzeta * bb * ff
            f[i+1,j+1] = (g * a[i+1,j+1] * (bb+db) + ff/(2*G*dzeta) )/(1 + 1/(2*G*dzeta))
        else:
            da1 = -dzeta * bb * ff
            df1 = dzeta * (g * aa * bb - ff)

            da2 = -dzeta * (bb + db/2) * (ff + df1/2)
            df2 = dzeta * (g * (aa + da1/2) * (bb + db/2) - (ff + df1/2))

            da3 = -dzeta * (bb + db/2) * (ff + df2/2)
            df3 = dzeta * (g * (aa + da2/2) * (bb + db/2) - (ff + df2/2))

            da4 = -dzeta * (bb + db) * (ff + df3)
            df4 = dzeta * (g * (aa + da3) * (bb + db) - (ff + df3))

            a[i+1,j+1] = aa + (da1 + 2*da2 + 2*da3 + da4)/6
            f[i+1,j+1] = ff + (df1 + 2*df2 + 2*df3 + df4)/6

    if i+2 < Ntau:
        b[i+2,:] = b[i+1,:] + dtau * a[i+1,:] * f[i+1,:]


print(a.shape)
print(b.shape)
print(f.shape)
print("any inf:", np.any(np.isinf(b)))
print("any nan:", np.any(np.isnan(b)))
print("any negative b:", np.any(b < -1e-9))
print("min b:", b.min(), "max b:", b.max())

blown = np.where(np.isinf(b))
if len(blown[0]) > 0:
    print(f"First blowup at tau index {blown[0].min()}, tau = {tau[blown[0].min()]:.2f}")
else:
    print("Simulation completed without blowups!")
